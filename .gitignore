# Electron build workspace. All of this is regenerated by `npm install` and
# `npm run build:all` in desktop/, and it runs to well over a gigabyte.
desktop/node_modules/
desktop/dist/

# The packaged copy of the drawing app, written by desktop/sync-bundle.js on
# every build. It is a duplicate of the files at the repo root.
desktop/bundled/

# Timestamped copies made by sync-and-run.bat.
backups/

# Windows / editor noise
Thumbs.db
desktop.ini
.DS_Store
*.swp
